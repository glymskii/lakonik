# ---- Основное ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Публичный URL API (нужен Better Auth для callback'ов и писем)
BASE_URL=http://localhost:3000
# Секрет для подписи сессий Better Auth (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-please-32-bytes-minimum

# ---- База данных (Railway Postgres или локальный docker-compose) ----
DATABASE_URL=postgres://adv:adv@localhost:5439/adv

# ---- Хранилище аудио (Railway Bucket или локальный MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=audio-temp
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# path | virtual-host. Для MinIO — path, для Railway Buckets смотри `railway bucket credentials` (urlStyle)
S3_URL_STYLE=path
# Публичный endpoint для presigned URL, если отличается от внутреннего (например, для MinIO в docker)
S3_PUBLIC_ENDPOINT=

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MODEL_DRAFT=claude-sonnet-5
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2

# ---- Email (одноразовые коды входа). Без ключа коды печатаются в лог ----
RESEND_API_KEY=
EMAIL_FROM="ADV Meetings <noreply@example.com>"

# ---- Вход ----
# Домены корпоративной почты через запятую. Пусто = любой домен (только для разработки)
ALLOWED_EMAIL_DOMAINS=
# Google Sign-In: web client id + iOS client id через запятую
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple. Для нативного входа с iPhone ничего заполнять не нужно (проверка по bundle ID).
# Service ID + ключ нужны только для веб-версии входа через Apple.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=kz.adv.meetings

# ---- Подписки App Store (StoreKit 2) ----
# Окружение подписей по умолчанию: Production для TestFlight и App Store, Sandbox — для сборок из Xcode.
APPSTORE_ENVIRONMENT=Production
# true — принимать и подписи песочницы (нужно, пока подписки проверяют в Sandbox и TestFlight)
APPSTORE_ALLOW_SANDBOX=false
# Числовой id приложения в App Store Connect (обязателен для проверки подписей Production)
APPSTORE_APP_APPLE_ID=6812003830
# Ключ App Store Server API (App Store Connect → Users and Access → Integrations → In-App Purchase).
# Нужен только для суточной сверки подписок; без него сверка пропускается с записью в лог.
APPSTORE_KEY_ID=
APPSTORE_ISSUER_ID=
# Содержимое .p8 одной строкой с \n вместо переводов строк
APPSTORE_PRIVATE_KEY=

# ---- Push (APNs) ----
# Ключ создаётся в Apple Developer → Certificates, Identifiers & Profiles → Keys → «+»,
# галочка «Apple Push Notifications service (APNs)». Скачанный AuthKey_XXXXXXXXXX.p8 даётся один раз.
# APNS_KEY_ID — 10 символов из имени файла (XXXXXXXXXX), APNS_TEAM_ID — Team ID аккаунта (JWL983DY46).
APNS_KEY_ID=
APNS_TEAM_ID=JWL983DY46
# Либо путь к файлу .p8 (локально) …
APNS_PRIVATE_KEY_FILE=
# … либо содержимое .p8 одной строкой с \n вместо переводов строк (для Railway)
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=kz.adv.meetings
# false — sandbox (сборки из Xcode на устройство), true — production (TestFlight / App Store)
APNS_PRODUCTION=false

# ---- Пайплайн ----
AUDIO_RETENTION_HOURS=48
PIPELINE_STUCK_MINUTES=30

# Наблюдаемость (необязательно): без ключей выключены
SENTRY_DSN=
AMPLITUDE_API_KEY=

# Корпоративный вход по коду организации: реестр серверов компаний (JSON)
# ORG_SERVERS=[{"code":"ADV","name":"ADV Kazakhstan","apiBaseUrl":"https://meetings.advgroup.kz","hint":"Вход с почты @advgroup.kz"}]
ORG_SERVERS=
