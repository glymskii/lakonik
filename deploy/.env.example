# ─── Домен и образ ───────────────────────────────────────────────────────────
LAKONIK_DOMAIN=meetings.advgroup.kz
LAKONIK_IMAGE=ghcr.io/glymskii/lakonik-server:latest
BASE_URL=https://meetings.advgroup.kz

# ─── Секреты инфраструктуры (сгенерируйте: openssl rand -hex 32) ─────────────
POSTGRES_PASSWORD=
MINIO_ROOT_USER=lakonik
MINIO_ROOT_PASSWORD=
BETTER_AUTH_SECRET=

# ─── Внешние AI-сервисы (ключи и биллинг — на стороне ADV) ───────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Модели по умолчанию можно не трогать
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL_DRAFT=claude-sonnet-5
# ELEVENLABS_MODEL_ID=scribe_v2

# ─── Почта: коды входа и приглашения (Resend или корпоративный SMTP) ─────────
RESEND_API_KEY=
EMAIL_FROM=Lakonik <noreply@advgroup.kz>

# ─── Кто может войти: домены агентств холдинга, через запятую ────────────────
ALLOWED_EMAIL_DOMAINS=advgroup.kz

# ─── Вход через Apple/Google (значения выдаёт разработчик приложения) ────────
APPLE_CLIENT_ID=kz.adv.meetings
APPLE_BUNDLE_ID=kz.adv.meetings
GOOGLE_CLIENT_IDS=

# ─── Push-уведомления: через relay разработчика (ключ APNs принадлежит команде Apple) ─
# Пока не настроено — приложение показывает прогресс, пока открыто (SSE). Заполняется позже.
PUSH_RELAY_URL=
PUSH_RELAY_TOKEN=

# ─── Хранение и обслуживание ────────────────────────────────────────────────
AUDIO_RETENTION_HOURS=48      # аудио и так удаляется сразу после расшифровки; это добивание остатков
PIPELINE_STUCK_MINUTES=30
LOG_LEVEL=info
