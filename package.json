{
  "name": "adv-meetings",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @lakonik/server dev",
    "worker": "pnpm --filter @lakonik/server worker",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @lakonik/server db:generate",
    "db:migrate": "pnpm --filter @lakonik/server db:migrate",
    "db:seed": "pnpm --filter @lakonik/server db:seed",
    "templates:extract": "tsx scripts/extract-templates.ts"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
